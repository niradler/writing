---
const title = "Piece by Piece";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}/favicon.svg`}
    />
    <meta
      name="description"
      content="Nir Adler's writing on software, systems, and building things."
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Nir Adler</title>
  </head>
  <body>
    <main>
      <p class="author">Nir Adler</p>
      <h1>{title}</h1>
      <p class="intro">On software, systems, and building things.</p>
      <p>
        This is the new home for my writing. While it takes shape, you can read
        my articles on the current blog.
      </p>
      <a href="https://blog.niradler.com/">
        Read the blog <span aria-hidden="true">↗</span>
      </a>
    </main>
  </body>
</html>

<style>
  :global(html) {
    color-scheme: light dark;
    background: light-dark(#faf9f6, #171817);
    color: light-dark(#252924, #e9ebe5);
    font-family: system-ui, sans-serif;
    line-height: 1.7;
  }

  :global(body) {
    margin: 0;
  }

  main {
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(4rem, 14vh, 9rem) 1.5rem;
  }

  .author {
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-block: 1.25rem 0.75rem;
    font-family: Georgia, serif;
    font-size: clamp(2.8rem, 9vw, 4.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .intro {
    font-size: 1.2rem;
  }

  a {
    color: light-dark(#246343, #a0d9b4);
    text-underline-offset: 0.25em;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }
</style>
