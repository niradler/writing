{
  "name": "piece-by-piece",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vitepress dev site --host 127.0.0.1",
    "build": "SITE_TARGET=preview vitepress build site",
    "build:production": "SITE_TARGET=production vitepress build site",
    "preview": "vitepress preview site --host 127.0.0.1 --port 4173",
    "test": "node --test",
    "check": "npm run test && node scripts/check-content.mjs",
    "check:built": "node scripts/check-built.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:hashnode": "node scripts/import-hashnode.mjs",
    "audit:media": "node scripts/audit-media.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "gray-matter": "4.0.3",
    "node-html-parser": "7.1.0",
    "playwright-core": "^1.55.0",
    "prettier": "3.9.10",
    "turndown": "7.2.4",
    "vitepress": "1.6.4"
  }
}
